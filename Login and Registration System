
#include <iostream>
#include <fstream>
using namespace std;

void registration()
{
    string username, password, u, p;

    cout << "\nEnter username: ";
    cin >> username;

    cout << "Enter password: ";
    cin >> password;

    ifstream file("users.txt");

    while (file >> u >> p)
    {
        if (u == username)
        {
            cout << "\nUsername already exists!" << endl;
            file.close();
            return;
        }
    }

    file.close();

    ofstream outfile("users.txt", ios::app);

    outfile << username << " " << password << endl;

    outfile.close();

    cout << "\nRegistration successful!" << endl;
}

void login()
{
    string username, password, u, p;
    bool found = false;

    cout << "\nEnter username: ";
    cin >> username;

    cout << "Enter password: ";
    cin >> password;

    ifstream file("users.txt");

    while (file >> u >> p)
    {
        if (u == username && p == password)
        {
            found = true;
            break;
        }
    }

    file.close();

    if (found)
    {
        cout << "\nLogin successful!" << endl;
        cout << "Welcome " << username << endl;
    }
    else
    {
        cout << "\nWrong username or password!" << endl;
    }
}

int main()
{
    int choice;

    do
    {
        cout << "\n===== LOGIN SYSTEM =====" << endl;
        cout << "1. Registration" << endl;
        cout << "2. Login" << endl;
        cout << "3. Exit" << endl;

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                registration();
                break;

            case 2:
                login();
                break;

            case 3:
                cout << "Program ended." << endl;
                break;

            default:
                cout << "Invalid choice!" << endl;
        }

    } while (choice != 3);

    return 0;
}
